---
config:
  layout: fixed
  theme: base
---

flowchart TB

    %% =========================
    %% Mobile App Interface and Analytics
    %% =========================

    START["Open App"]
    CONNECTED{"Target Connected?"}
    SCAN["Show BLE Scan<br/>and Connect Screen"]
    STATE["Request Current<br/>Target State"]
    LIVE["Live Dashboard<br/>Mode, Score, Distance,<br/>Threshold, Battery"]
    CONTROL["Remote Controls<br/>Mode / Distance / Calibration"]
    SHOT["Receive Shot Packet"]
    SAVE["Save Shot Locally"]
    ANALYTICS["Update Analytics<br/>Averages, Trends, History"]
    OFFLINE{"Saved History Exists?"}
    HISTORY["Show Local History"]
    EMPTY["Show Connect Prompt"]

    START --> CONNECTED
    CONNECTED -- Yes --> STATE --> LIVE
    LIVE --> CONTROL
    LIVE --> SHOT --> SAVE --> ANALYTICS --> LIVE
    CONNECTED -- No --> OFFLINE
    OFFLINE -- Yes --> HISTORY
    OFFLINE -- No --> EMPTY --> SCAN

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class START,CONNECTED,SCAN,STATE,LIVE,CONTROL,SHOT,SAVE,ANALYTICS,OFFLINE,HISTORY,EMPTY app;
