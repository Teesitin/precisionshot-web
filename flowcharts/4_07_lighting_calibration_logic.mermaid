---
config:
  layout: fixed
  theme: base
---

flowchart LR

    %% =========================
    %% Lighting Calibration Flow
    %% =========================

    subgraph INPUTS["Calibration Inputs"]
        direction TB
        ENCODER["Rotary Encoder"]
        APP["App Preset or Custom Value"]
        ROOM["Room Lighting Conditions"]
    end

    THRESHOLD["Global Detection<br/>Threshold Value"]

    subgraph APPLY["Apply Threshold"]
        direction TB
        DISPLAY["Update LCD<br/>Threshold Display"]
        SENSOR["Use Threshold During<br/>Sensor Filtering"]
        STATE["Save Current<br/>System State"]
    end

    subgraph PRESETS["Possible App Presets"]
        direction TB
        DARK["Dark Room"]
        NORMAL["Normal Room"]
        BRIGHT["Bright Room"]
        CUSTOM["Custom Value"]
    end

    ENCODER --> THRESHOLD
    APP --> THRESHOLD
    ROOM --> THRESHOLD
    PRESETS --> APP
    THRESHOLD --> DISPLAY
    THRESHOLD --> SENSOR
    THRESHOLD --> STATE

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class ENCODER,DISPLAY,SENSOR,STATE target;
class APP,DARK,NORMAL,BRIGHT,CUSTOM app;
class ROOM,THRESHOLD process;
