---
config:
  layout: fixed
  theme: base
---

flowchart TB

    %% =========================
    %% microSD Storage Role
    %% =========================

    TARGET["ESP32-S3 Target"]
    EVENT["Shot Event or System Event"]
    NORMAL["Normal JSON Log<br/>shot, score, mode,<br/>distance, threshold"]
    DEBUG["Debug JSON Log<br/>sensor IDs, readings,<br/>timing, firmware state"]
    SD["microSD Card<br/>Device-Side Logs"]
    REVIEW["Computer Review<br/>Testing and Troubleshooting"]
    CLEANUP["Possible Auto Cleanup<br/>Delete Older Logs When Full"]
    APP["Mobile App<br/>Main User History"]

    TARGET --> EVENT
    EVENT --> NORMAL --> SD
    EVENT --> DEBUG --> SD
    SD --> REVIEW
    SD --> CLEANUP
    EVENT --> APP

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class TARGET,EVENT,NORMAL,DEBUG target;
class SD,REVIEW,CLEANUP storage;
class APP app;
