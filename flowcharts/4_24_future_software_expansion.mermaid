---
config:
  theme: base
---

flowchart LR

    %% =========================
    %% Future Software Expansion Roadmap
    %% =========================

    subgraph PROTOTYPE["Prototype Scope"]
        direction TB
        SINGLE["Single Local Profile"]
        MANUAL["Manual Distance Entry"]
        JSON["JSON BLE Packets"]
        GLOBAL["Global Threshold"]
        FOURMODES["Four Training Modes"]
        LOCAL["Local App Storage"]
    end

    subgraph FUTURE["Future / Stretch Features"]
        direction TB
        MULTI["Multiple Local Profiles"]
        AUTO["Automatic Distance Tracking"]
        BINARY["Compact Binary Protocol"]
        PERSENSOR["Per-Sensor Calibration"]
        AI["AI-Assisted Coaching"]
        CUSTOM["Custom Drills"]
        EXPORT["Exportable Training Files"]
        BACKUP["Optional User-Controlled Backups"]
    end

    SINGLE -. later .-> MULTI
    MANUAL -. later .-> AUTO
    JSON -. optimize .-> BINARY
    GLOBAL -. testing need .-> PERSENSOR
    FOURMODES -. expand .-> CUSTOM
    LOCAL -. optional .-> EXPORT
    LOCAL -. optional .-> BACKUP
    CUSTOM -. advanced .-> AI

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class SINGLE,MANUAL,JSON,GLOBAL,FOURMODES,LOCAL target;
class MULTI,AUTO,BINARY,PERSENSOR,AI,CUSTOM,EXPORT,BACKUP future;
