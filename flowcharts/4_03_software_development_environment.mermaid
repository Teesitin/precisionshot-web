---
config:
  layout: fixed
  theme: base
---

flowchart LR

    %% =========================
    %% Software Stack Decision
    %% =========================

    subgraph FIRMWARE["Embedded Firmware"]
        direction TB
        CPP["C++"]
        ESPIDF["ESP-IDF"]
        VSCODE["Visual Studio Code"]
        HARDWARE["Direct Hardware Control<br/>Sensors / BLE / LCD / SD"]
        CPP --> ESPIDF --> VSCODE --> HARDWARE
    end

    subgraph MOBILE["Mobile Application"]
        direction TB
        TS["TypeScript"]
        RN["React Native"]
        EXPO["Expo"]
        ANDROID["Android Prototype App"]
        TS --> RN --> EXPO --> ANDROID
    end

    subgraph TESTING["Development Testing"]
        direction TB
        PY["Python Scripts"]
        LOGS["Log Analysis"]
        PLOTS["Sensor Plots<br/>and Simulations"]
        PY --> LOGS --> PLOTS
    end

    HARDWARE <--> ANDROID
    HARDWARE --> LOGS

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class CPP,ESPIDF,VSCODE,HARDWARE target;
class TS,RN,EXPO,ANDROID app;
class PY,LOGS,PLOTS process;
