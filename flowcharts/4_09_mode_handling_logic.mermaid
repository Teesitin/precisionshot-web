---
config:
  layout: fixed
  theme: base
---

flowchart LR

    %% =========================
    %% Training Mode Handling
    %% =========================

    subgraph CONTROLS["Mode Selection"]
        direction TB
        DEVICE["Physical Target Controls"]
        APPCTRL["Mobile App Controls"]
    end

    STATE["Current Mode<br/>Stored in System State"]

    subgraph MODES["Training Modes"]
        direction TB
        FREESTYLE["Freestyle<br/>Free Shooting"]
        CLASSIC["Classic<br/>Shot Count + Total Score"]
        RAPID["Rapid<br/>Small Active Target Zone"]
        MOVING["Moving Target<br/>Moving Active Zone"]
    end

    subgraph OUTPUTS["Mode-Dependent Behavior"]
        direction TB
        SCORE["Scoring Rule"]
        DISPLAY["Display Output"]
        BLE["BLE Data Fields"]
        TARGET["Target Behavior<br/>Static / Jumping / Moving"]
    end

    DEVICE --> STATE
    APPCTRL --> STATE
    STATE --> MODES
    MODES --> SCORE
    MODES --> DISPLAY
    MODES --> BLE
    MODES --> TARGET

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class DEVICE,STATE,FREESTYLE,CLASSIC,RAPID,MOVING,SCORE,DISPLAY,TARGET target;
class APPCTRL app;
class BLE ble;
