---
config:
  layout: fixed
  theme: base
---

flowchart LR

    %% =========================
    %% Sensor Processing and Multiplexer Architecture
    %% =========================

    subgraph ARRAY["Phototransistor Sensor Array"]
        direction TB
        ROWS["Sensor Grid<br/>Rows and Columns"]
        IDS["Known Sensor IDs"]
        COORDS["Known X/Y Coordinates"]
        ROWS --> IDS --> COORDS
    end

    subgraph MUX["Multiplexer Hardware"]
        direction TB
        GROUPS["Sensor Groups"]
        SELECT["Select Channel"]
        READ["Read Analog / Digital Value"]
        GROUPS --> SELECT --> READ
    end

    subgraph ESP["ESP32-S3 Processing"]
        direction TB
        SCAN["Scan All Groups"]
        MAP["Map Sensor ID<br/>to Coordinate"]
        THRESHOLD["Apply Global Threshold"]
        CLUSTER["Build Valid Shot Cluster"]
        OUTPUT["Candidate Shot Data"]
        SCAN --> MAP --> THRESHOLD --> CLUSTER --> OUTPUT
    end

    ARRAY --> MUX --> ESP

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class ROWS,IDS,COORDS,GROUPS,SELECT,READ target;
class SCAN,MAP,THRESHOLD,CLUSTER,OUTPUT process;
