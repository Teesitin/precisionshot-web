---
config:
  theme: base
---

flowchart LR

    %% =========================
    %% Normal Logging vs Debug Logging
    %% =========================

    EVENT["Shot or System Event"]

    subgraph NORMAL["Normal Mode"]
        N1["Final Shot Location"]
        N2["Score and Mode"]
        N3["Distance and Timestamp"]
        N4["Battery / Connection Status"]
    end

    subgraph DEBUG["Debug Mode"]
        D1["Active Sensor IDs"]
        D2["Raw / Filtered Values"]
        D3["Threshold and Calibration"]
        D4["Processing Time"]
        D5["Firmware State"]
    end

    subgraph OUTPUTS["Log Destinations"]
        SD["microSD JSON Logs"]
        APPDB["App Local History"]
        DEV["Developer Review"]
    end

    EVENT --> NORMAL --> SD
    EVENT --> NORMAL --> APPDB
    EVENT --> DEBUG --> SD
    DEBUG --> DEV

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class EVENT,N1,N2,N3,N4 target;
class D1,D2,D3,D4,D5 process;
class SD,APPDB,DEV storage;
