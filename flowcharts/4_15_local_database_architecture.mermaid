---
config:
  layout: fixed
  theme: base
---

flowchart LR

    %% =========================
    %% Local App Database Architecture
    %% =========================

    subgraph SQLITE["SQLite Local Database"]
        direction TB
        SETTINGS["settings<br/>mode, distance, units,<br/>threshold"]
        SHOTS["shots<br/>timestamp, mode, x, y,<br/>score, distance, threshold"]
        DAILY["daily_history<br/>date, shot count,<br/>average score"]
        DEBUG["debug_records<br/>optional developer data"]
    end

    subgraph APP["App Features"]
        DASHBOARD["Live Dashboard"]
        HISTORY["History by Date"]
        ANALYTICS["Analytics"]
        DEBUGVIEW["Debug View"]
    end

    SHOTS --> DAILY
    SETTINGS --> DASHBOARD
    SHOTS --> HISTORY
    DAILY --> ANALYTICS
    DEBUG --> DEBUGVIEW

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class SETTINGS,SHOTS,DAILY,DEBUG storage;
class DASHBOARD,HISTORY,ANALYTICS,DEBUGVIEW app;
