---
config:
  layout: fixed
  theme: base
---

flowchart LR

    %% =========================
    %% Mobile Application Architecture
    %% =========================

    subgraph UI["User Interface Layer"]
        DASHBOARD["Live Dashboard"]
        HISTORY["History Screens"]
        SETTINGS["Settings Screens"]
        DEBUGUI["Debug View"]
    end

    subgraph BLELAYER["Bluetooth Layer"]
        SCAN["Device Scanner"]
        CONNECT["Connection Manager"]
        PARSE["JSON Packet Parser"]
        COMMANDS["Command Sender"]
    end

    subgraph DATA["Local Data Layer"]
        SQLITE["SQLite Database"]
        SHOTS["Shot Records"]
        CONFIG["Saved Settings"]
        DEBUGLOG["Debug Records"]
    end

    subgraph ANALYTICS["Analytics Layer"]
        AVG["Average Score"]
        TRENDS["Accuracy Trends"]
        MODESTATS["Performance by Mode"]
        DISTSTATS["Performance by Distance"]
    end

    UI <--> BLELAYER
    BLELAYER <--> DATA
    DATA --> ANALYTICS
    ANALYTICS --> UI

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class DASHBOARD,HISTORY,SETTINGS,DEBUGUI,SCAN,CONNECT,PARSE,COMMANDS,AVG,TRENDS,MODESTATS,DISTSTATS app;
class SQLITE,SHOTS,CONFIG,DEBUGLOG storage;
