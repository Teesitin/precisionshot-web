---
config:
  layout: fixed
  theme: base
---

flowchart LR

    %% =========================
    %% BLE Communication Protocol
    %% =========================

    subgraph TARGET["ESP32-S3 Target"]
        STATE["System State"]
        SHOT["Shot Event"]
        ERROR["Error Event"]
        DEBUG["Debug Event"]
    end

    subgraph PROTOCOL["Event-Based BLE Protocol"]
        ADV["Advertise Device"]
        NOTIFY["Notify App<br/>on Important Events"]
        COMMAND["Receive App Command"]
        SYNC["Send State Update"]
    end

    subgraph APP["Mobile App"]
        SCAN["Scan and Connect"]
        UPDATE["Update Interface"]
        CONTROL["Send Mode, Distance,<br/>Threshold, Reset, Debug"]
    end

    ADV --> SCAN
    STATE --> SYNC --> UPDATE
    SHOT --> NOTIFY --> UPDATE
    ERROR --> NOTIFY
    DEBUG --> NOTIFY
    CONTROL --> COMMAND --> STATE

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class STATE,SHOT,ERROR,DEBUG target;
class ADV,NOTIFY,COMMAND,SYNC ble;
class SCAN,UPDATE,CONTROL app;
