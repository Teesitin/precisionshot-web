---
config:
  layout: fixed
  theme: base
---

flowchart TB

    %% =========================
    %% JSON Packet Structure
    %% =========================

    subgraph PACKETS["Prototype JSON Packets"]
        direction TB
        SHOT["Shot Packet<br/>type, shotId, x, y,<br/>score, mode, timestamp"]
        STATE["State Update Packet<br/>mode, distance, threshold,<br/>battery, BLE status"]
        COMMAND["Command Packet<br/>setMode, setDistance,<br/>setThreshold, reset, debug"]
        DEBUG["Debug Packet<br/>activeSensorIds, readings,<br/>threshold, timing"]
    end

    subgraph USAGE["Packet Usage"]
        APPDISPLAY["App Display"]
        APPDB["Local SQLite Save"]
        TARGETSTATE["Target State Update"]
        TESTING["Testing and Tuning"]
    end

    SHOT --> APPDISPLAY
    SHOT --> APPDB
    STATE --> APPDISPLAY
    COMMAND --> TARGETSTATE
    DEBUG --> TESTING

    FUTURE["Future Option<br/>Compact Binary Format<br/>if JSON is too large"]
    PACKETS -. possible optimization .-> FUTURE

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class SHOT,STATE,COMMAND,DEBUG ble;
class APPDISPLAY,APPDB app;
class TARGETSTATE target;
class TESTING process;
class FUTURE future;
