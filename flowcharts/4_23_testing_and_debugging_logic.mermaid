---
config:
  theme: base
---

flowchart TB

    %% =========================
    %% Software Test Matrix
    %% =========================

    TESTING["Software Testing Process"]

    subgraph UNIT["Feature-Level Tests"]
        SENSOR["Sensor Scan Test"]
        SHOT["Shot Detection Test"]
        SCORE["Scoring Test"]
        CAL["Calibration Test"]
        DISPLAY["LCD Update Test"]
        BLE["BLE Packet Test"]
        SD["microSD Log Test"]
        APP["App Storage Test"]
    end

    subgraph CONDITIONS["Realistic Conditions"]
        DARK["Dark Room"]
        NORMAL["Normal Lighting"]
        BRIGHT["Bright Room"]
        DISTANCE["Different Distances"]
        DISCONNECT["BLE Disconnects"]
        MULTI["Multiple Shot Clusters"]
    end

    subgraph INTEGRATION["Full System Integration"]
        COMPLETE["Target + App + Logs"]
        VERIFY["Compare Actual Hit<br/>to Calculated Location"]
        TUNE["Tune Thresholds<br/>and Detection Logic"]
    end

    TESTING --> UNIT
    UNIT --> CONDITIONS
    CONDITIONS --> INTEGRATION
    COMPLETE --> VERIFY --> TUNE

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class TESTING,SENSOR,SHOT,SCORE,CAL,DISPLAY target;
class BLE ble;
class SD storage;
class APP app;
class DARK,NORMAL,BRIGHT,DISTANCE,DISCONNECT,MULTI,COMPLETE,VERIFY,TUNE process;
