---
config:
  layout: fixed
  theme: base
---

flowchart TB

    %% =========================
    %% Shot Detection Algorithm
    %% =========================

    START(["Sensor Readings Available"])
    THRESHOLD{"Any Sensor Above<br/>Global Threshold?"}
    IGNORE["Ignore as Ambient Light<br/>or No Shot"]
    STRONGEST["Find Strongest<br/>Triggered Sensor"]
    NEARBY["Check Nearby<br/>Triggered Sensors"]
    CLUSTER{"Valid Local Cluster?"}
    OUTLIER["Reject Weak or<br/>Distant Outliers"]
    MULTI{"Second Strong<br/>Distant Cluster?"}
    ERROR["Reject Shot<br/>Multiple Shots Detected"]
    CENTROID["Calculate Weighted<br/>Centroid Location"]
    RESULT["Final Shot Location"]
    PASS["Pass Result to Scoring,<br/>Display, Log, and BLE"]

    START --> THRESHOLD
    THRESHOLD -- No --> IGNORE
    THRESHOLD -- Yes --> STRONGEST --> NEARBY --> CLUSTER
    CLUSTER -- No --> IGNORE
    CLUSTER -- Yes --> OUTLIER --> MULTI
    MULTI -- Yes --> ERROR
    MULTI -- No --> CENTROID --> RESULT --> PASS

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class START,THRESHOLD,STRONGEST,NEARBY,CLUSTER,OUTLIER,MULTI,CENTROID,RESULT,PASS target;
class IGNORE,ERROR warn;
