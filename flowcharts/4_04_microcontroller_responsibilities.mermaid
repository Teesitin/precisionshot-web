---
config:
  layout: fixed
  theme: base
---

flowchart TB

    %% =========================
    %% ESP32-S3 Firmware Responsibilities
    %% =========================

    MCU["ESP32-S3 Firmware Core"]

    subgraph REALTIME["Real-Time Target Control"]
        SENSORS["Read Sensor Array"]
        DETECT["Detect Valid Shot"]
        LOCATION["Calculate Shot Location"]
        SCORE["Calculate Score"]
    end

    subgraph DEVICEUI["Standalone User Interface"]
        DISPLAY["Update LCD Display"]
        BUTTONS["Read Buttons"]
        ENCODER["Read Rotary Encoder"]
        SETTINGS["Update Mode, Distance,<br/>Threshold, Reset"]
    end

    subgraph COMM["Communication and Storage"]
        BLE["BLE Communication"]
        SD["microSD JSON Logs"]
        STATE["System State Manager"]
    end

    MCU --> SENSORS --> DETECT --> LOCATION --> SCORE --> STATE
    MCU --> BUTTONS --> SETTINGS --> STATE
    MCU --> ENCODER --> SETTINGS
    STATE --> DISPLAY
    STATE --> BLE
    STATE --> SD

classDef target fill:#e8f1ff,stroke:#2563eb,stroke-width:2px,color:#102033;
classDef app fill:#ecfdf5,stroke:#16a34a,stroke-width:2px,color:#102033;
classDef ble fill:#fff7ed,stroke:#f97316,stroke-width:2px,color:#102033;
classDef storage fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#102033;
classDef process fill:#f8fafc,stroke:#64748b,stroke-width:2px,color:#102033;
classDef warn fill:#fef2f2,stroke:#dc2626,stroke-width:2px,color:#102033;
classDef future fill:#f1f5f9,stroke:#475569,stroke-width:2px,stroke-dasharray:5 5,color:#102033;

class MCU,SENSORS,DETECT,LOCATION,SCORE,DISPLAY,BUTTONS,ENCODER,SETTINGS,STATE target;
class BLE ble;
class SD storage;
